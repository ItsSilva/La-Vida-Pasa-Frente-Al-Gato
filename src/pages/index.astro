---
import { getImage } from 'astro:assets';
import PhotoFigure from '../components/PhotoFigure.astro';
import StoryScene from '../components/StoryScene.astro';
import story from '../content/cronica.json';
import { cover, leadLength, scenes } from '../data/layout';
import '@fontsource-variable/montserrat/wght.css';
import '@fontsource-variable/montserrat/wght-italic.css';
import '@fontsource-variable/playfair-display/wght.css';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '../styles/global.css';

const canonical = Astro.site && new URL('/', Astro.site);
const socialPhoto = canonical && await getImage({ src: cover.image, width: 960, format: 'webp', quality: 86 });
const description = story.paragraphs[0].runs.map(run => run.text).join('').slice(0, leadLength);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080808" />
    <title>{story.title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={story.byline} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={story.title} />
    <meta property="og:description" content={description} />
    {canonical && <link rel="canonical" href={canonical.href} />}
    {canonical && <meta property="og:url" content={canonical.href} />}
    {canonical && socialPhoto && <meta property="og:image" content={new URL(socialPhoto.src, canonical).href} />}
    {socialPhoto && <meta property="og:image:alt" content={cover.alt} />}
    <link rel="icon" href="/favicon.png" type="image/png" />
  </head>
  <body>
    <a class="skip-link" href="#cronica">Saltar a la crónica</a>
    <main>
      <article id="cronica" aria-labelledby="titulo" tabindex="-1">
        <header class="cover" id="inicio" tabindex="-1">
          <div class="cover__copy">
            <h1 id="titulo" data-story-title>{story.title}</h1>
            <p class="cover__byline" data-story-byline>{story.byline}</p>
          </div>
          <PhotoFigure photo={cover} cover />
        </header>
        <div class="story">
          {scenes.map(({ from, through, side, photo }) => (
            <StoryScene paragraphs={story.paragraphs.slice(from - 1, through)} side={side} photo={photo} />
          ))}
        </div>
      </article>
    </main>
    <footer class="footer">
      <div class="footer__content">
        <small>Fotografías: Juan Sebastián Silva</small>
        <a href="#inicio">Volver al inicio</a>
      </div>
    </footer>
  </body>
</html>
